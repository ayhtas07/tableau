      <aliases enabled='yes' />
      <column caption='Total Exceptions' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1423065766354944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Exception Amt])' />
      </column>
      <column caption='Current Year Exceptions' datatype='real' name='[Calculation_1423065766629377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2025 THEN [Exception Amt] ELSE 0 END' />
      </column>
      <column caption='Previous Year Exceptions' datatype='real' name='[Calculation_1423065766760450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2024 THEN [Exception Amt] ELSE 0 END' />
      </column>
      <column caption='Exception Reason' datatype='string' name='[Calculation_1423065767108612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Policy Exception], &quot;TIME&quot;) OR CONTAINS([Policy Exception], &quot;Time&quot;) THEN &quot;Declined Due To Time&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;CARRIER&quot;) OR CONTAINS([Policy Exception], &quot;AIRCRAFT&quot;) THEN &quot;Declined Due To Carrier/Aircraft&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;ROUTING&quot;) THEN &quot;Declined Due To Routing&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;PENALTY&quot;) OR CONTAINS([Policy Exception], &quot;RESTRICTION&quot;) THEN &quot;Declined Due To Penalty/Restrictions&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;CONNECTION&quot;) OR CONTAINS([Policy Exception], &quot;STOPOVER&quot;) THEN &quot;Declined Due To Connx/Stopover&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;TRAVEL WITH&quot;) THEN &quot;Declined Travel With Another Person&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;AIRPORT&quot;) THEN &quot;Declined Due To Airport Preference&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;SEATING&quot;) OR CONTAINS([Policy Exception], &quot;SEAT&quot;) THEN &quot;Declined Due To Seating Preference&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;BUSINESS CLASS&quot;) THEN &quot;Declined - Flew Business Class&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;FIRST CLASS&quot;) THEN &quot;Declined - Flew First Class&quot;&#13;&#10;ELSEIF CONTAINS([Policy Exception], &quot;MILEAGE&quot;) OR CONTAINS([Policy Exception], &quot;UPGRADE&quot;) THEN &quot;Declined Due To Mileage Program/Upgrade&quot;&#13;&#10;ELSE [Policy Exception]&#13;&#10;END' />
      </column>
      <column caption='Exception Category' datatype='string' name='[Calculation_1423065768742917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Policy Exception]&#13;&#10;    WHEN &quot;TIME&quot; THEN &quot;Declined Due To Time&quot;&#13;&#10;    WHEN &quot;UPPER CLASS AUTHORIZED&quot; THEN &quot;Declined - Upper Class Authorized&quot;&#13;&#10;    WHEN &quot;TRAVELING WITH OTHERS&quot; THEN &quot;Declined - Traveling With Others&quot;&#13;&#10;    WHEN &quot;UPPER CLASS SEATING PREFERENCE&quot; THEN &quot;Declined - Seating Preference&quot;&#13;&#10;    WHEN &quot;NOT PROVIDED BY OBT&quot; THEN &quot;Not Provided By OBT&quot;&#13;&#10;    WHEN &quot;UPPER CLASS ECONOMY NOT AVAILABLE&quot; THEN &quot;Economy Not Available&quot;&#13;&#10;    WHEN &quot;UPPER CLASS CHEAPER EQUAL TO ECONOMY&quot; THEN &quot;Upper Class Cheaper/Equal to Economy&quot;&#13;&#10;    WHEN &quot;E&quot; THEN &quot;Economy&quot;&#13;&#10;    WHEN &quot;H&quot; THEN &quot;H Class&quot;&#13;&#10;    WHEN &quot;L&quot; THEN &quot;L Class&quot;&#13;&#10;    WHEN &quot;N&quot; THEN &quot;N Class&quot;&#13;&#10;    WHEN &quot;R&quot; THEN &quot;R Class&quot;&#13;&#10;    WHEN &quot;T&quot; THEN &quot;T Class&quot;&#13;&#10;    ELSE [Policy Exception]&#13;&#10;END' />
      </column>
      <column caption='Low Fare Acceptance %' datatype='real' default-format='p0%' name='[Calculation_1423065773637638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(COUNTD(IF ISNULL([Policy Exception]) THEN [Rec Loc] END)) &#13;&#10;/ &#13;&#10;FLOAT(COUNTD([Rec Loc]))' />
      </column>
      <column caption='Client Group Name Demo' datatype='string' name='[Client_Group_Name_Demo]' role='dimension' type='nominal' />
