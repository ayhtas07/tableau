      </column>
      <column caption='Prev Spend' datatype='real' name='[Calculation_3526157345439745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Issue Date]) = 2024 THEN [Total Cost] END)' />
      </column>
      <column caption='Total Spend' datatype='real' name='[Calculation_3526157347696643]' role='measure' type='quantitative'>
