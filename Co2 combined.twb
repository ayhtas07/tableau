      <aliases enabled='yes' />
      <column datatype='string' name='[Airline/Vendor]' role='dimension' type='nominal' />
      <column caption='Current Year CO2 Lbs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_0434880427667457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2025 THEN [Co2 (Lbs)] ELSE 0 END' />
      </column>
      <column caption='Previous Year CO2 Lbs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_0434880427737090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2024 THEN [Previous Issue Year Total CO2 Lbs] ELSE 0 END' />
      </column>
      <column caption='YoY Difference CO2 Lbs' datatype='real' name='[Calculation_0434880430379013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0434880427667457] - [Calculation_0434880427737090]' />
      </column>
      <column caption='YoY % CO2 Lbs' datatype='real' default-format='p0%' name='[Calculation_0434880430481414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0434880427667457]) - SUM([Calculation_0434880427737090])) / SUM([Calculation_0434880427737090])' />
      </column>
      <column caption='Total Miles AR' datatype='integer' name='[Calculation_0434880430665735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Miles])' />
      </column>
      <column caption='Total Segment AR' datatype='integer' name='[Calculation_0434880430731272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Number of Segments])' />
      </column>
      <column caption='Avg Co2 Per Unit' datatype='real' name='[Calculation_0434880430817289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Co2 (Lbs)]) / SUM([Total Number of Segments])' />
      </column>
      <column caption='Air CO2 Only' datatype='real' name='[Calculation_0434880430882826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Category] = &quot;Air&quot; OR [Category] = &quot;Rail&quot; THEN [Co2 (Lbs)] ELSE 0 END' />
      </column>
      <column caption='Hotel CO2 Only' datatype='real' name='[Calculation_0434880430952459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Category] = &quot;Hotel&quot; THEN [Co2 (Lbs)] ELSE 0 END' />
      </column>
      <column caption='Car CO2 Only' datatype='real' name='[Calculation_0434880431013900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Category] = &quot;Car&quot; THEN [Co2 (Lbs)] ELSE 0 END' />
      </column>
      <column caption='Market Pair Combined' datatype='string' name='[Calculation_0434880431087629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Origin City] + &quot; - &quot; + [Dest City]' />
