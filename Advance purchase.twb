      <column caption='Advance Purchase Bucket' datatype='string' name='[Calculation_0623445884112898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Days Adv] &lt;= 2 THEN &quot;0-2 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 6 THEN &quot;3-6 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 13 THEN &quot;7-13 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 20 THEN &quot;14-20 Days&quot;&#13;&#10;ELSE &quot;21+ Days&quot;&#13;&#10;END' />
      </column>
      <column caption='7+ Advance Purchase %' datatype='real' default-format='p0%' name='[Calculation_0623445884256259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Days Adv] &gt;= 7 THEN 1 ELSE 0 END) / &#13;&#10;SUM(IF NOT ISNULL([Days Adv]) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='14+ Advance Purchase %' datatype='real' default-format='p0%' name='[Calculation_0623445884452868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Days Adv] &gt;= 14 THEN 1 ELSE 0 END) / &#13;&#10;SUM(IF NOT ISNULL([Days Adv]) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Current Year Tickets' datatype='integer' name='[Calculation_0623445884641285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2025 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Previous Year Tickets' datatype='integer' name='[Calculation_0623445884784646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2024 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Current Year Spend' datatype='real' name='[Calculation_0623445884932103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2025 THEN [Total Airfare] ELSE 0 END' />
      </column>
      <column caption='Previous Year Spend' datatype='real' name='[Calculation_0623445885009928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Issue Date]) = 2024 THEN [Total Airfare] ELSE 0 END' />
      </column>
      <column caption='Average Fare' datatype='real' name='[Calculation_0623445885112329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Airfare]) / COUNTD([Rec Loc])' />
      </column>
      <column caption='Current Avg Fare' datatype='real' name='[Calculation_0623445913284620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0623445884932103]) / SUM([Calculation_0623445884641285])' />
      </column>
      <column caption='Previous Avg Fare' datatype='real' name='[Calculation_0623445913440269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0623445885009928]) / SUM([Calculation_0623445884784646])' />
      </column>
      <column caption='Advance_Purchase Bucket' datatype='string' name='[Calculation_0623445922807822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Days Adv] &lt;= 2 THEN &quot;0-2 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 6 THEN &quot;3-6 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 13 THEN &quot;7-13 Days&quot;&#13;&#10;ELSEIF [Days Adv] &lt;= 20 THEN &quot;14-20 Days&quot;&#13;&#10;ELSE &quot;21+ Days&quot;&#13;&#10;END' />
